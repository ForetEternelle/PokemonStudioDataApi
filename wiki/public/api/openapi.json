          "description" : "The language of the response",
          "in" : "query",
          "name" : "lang",
          "required" : false,
          "schema" : {
            "default" : "en",
            "maxLength" : 5,
            "type" : "string"
          }
        }, {
          "description" : "The size of the scroll",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "maximum" : 100,
            "type" : "integer"
          }
        }, {
          "description" : "Start de search after this id. Used for scrolling.",
          "in" : "query",
          "name" : "lastId",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "minimum" : 1,
            "nullable" : true,
            "type" : "integer"
          }
        }, {
          "description" : "Start de search after this form. Used for scrolling.",
          "in" : "query",
          "name" : "lastForm",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "minimum" : 0,
            "nullable" : true,
            "type" : "integer"
          }
        }, {
          "description" : "Whether to only include main forms of pokemon (e.g. excluding mega evolutions, regional forms, etc.)",
          "in" : "query",
          "name" : "mainFormsOnly",
          "required" : false,
          "schema" : {
            "default" : true,
            "type" : "boolean"
          }
        }, {
          "description" : "Search query to filter pokemon by name, number",
          "in" : "query",
          "name" : "query",
          "required" : false,
          "schema" : {
            "maxLength" : 30,
            "nullable" : true,
            "type" : "string"
          }
        }, {
          "description" : "Filter pokemon by types. Multiple types can be specified, in which case pokemon that match any of the specified types will be included in the results.",
          "example" : [ "fire", "flying" ],
          "in" : "query",
          "name" : "types",
          "required" : false,
          "schema" : {
            "default" : [ ],
            "items" : {
              "maxLength" : 20,
              "type" : "string"
            },
            "type" : "array"
          }
        }, {
          "description" : "Filter pokemon by tags. Multiple tags can be specified, in which case pokemon that match any of the specified tags (on the pokemon or its form) will be included in the results.",
          "example" : [ "starter", "legendary" ],
          "in" : "query",
          "name" : "withTags",
          "required" : false,
          "schema" : {
            "default" : [ ],
            "items" : {
              "maxLength" : 30,
              "type" : "string"
            },
            "type" : "array"
          }
        }, {
          "description" : "Exclude pokemon matching any of the specified tags (on the pokemon or its form) from the results.",
          "example" : [ "mega", "regional" ],
          "in" : "query",
          "name" : "withoutTags",
          "required" : false,
          "schema" : {
            "default" : [ ],
            "items" : {
              "maxLength" : 30,
              "type" : "string"
            },
            "type" : "array"
          }
